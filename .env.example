# Copia este archivo como .env y llena los valores. El .env nunca se sube a Git.

# Puerto local del servidor
PORT=

# Ruta del archivo SQLite (opcional; por defecto data/bandeja.db)
DB_PATH=

# Versión de Graph API (se confirma en la documentación oficial de Meta)
GRAPH_API_VERSION=

# Token de acceso (temporal en la mañana 1)
WHATSAPP_TOKEN=

# Identificador del número de prueba de Meta
WHATSAPP_PHONE_NUMBER_ID=

# Identificador de la cuenta de WhatsApp Business (de prueba)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Teléfono de prueba registrado como destinatario
TEST_RECIPIENT_PHONE=

# App secret de la app (para validar X-Hub-Signature-256)
APP_SECRET=

# Token de verificación del webhook (lo inventas tú)
VERIFY_TOKEN=

# Contraseña de los usuarios ficticios de la demo (mínimo 8 caracteres; la inventas tú)
DEMO_PASSWORD=
